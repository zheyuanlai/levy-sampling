results/**
!results/**/
!results/**/*.csv
!results/**/manifest.json
__pycache__/
*.pyc
.ipynb_checkpoints/
*.npz
# reusable numerical caches (basin maps etc.), not run results
cache/
dist/
executed_notebooks/
.matplotlib-cache/
.DS_Store
# internal working notes, kept local only
REVISION_NOTES.md
REVISION_NOTES_manuscript.md
