# Git holds the SOURCE package: src/, configs/, notebooks/, scripts/, tests/,
# README, and the environment lock. That is everything needed to run from zero.
#
# The FROZEN RELEASE additionally carries results, figures, resolved configs,
# manifests, and executed notebooks. It is assembled by
# `scripts/build_release.py --frozen`, which zips the working tree, so those
# artifacts do not need to be tracked here.

# Run artifacts. Every variant writes its own directory under
# results/<experiment>/runs/<method>/<run-id>/, all of it regenerable from the
# source package, and catalog.csv is a derived index.
results/
figures/
executed_notebooks/
dist/

# Reusable numerical caches: basin maps, FEE calibrations, reference banks.
cache/
.matplotlib-cache/

__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

*.log
.DS_Store

# Internal working notes, kept local.
REVISION_NOTES.md
REVISION_NOTES_manuscript.md
